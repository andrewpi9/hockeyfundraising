# ============================================================================
# Every value here is a placeholder. Real values live in .env.local (ignored)
# or in your host's secret manager. Nothing in this file is ever committed live.
# ============================================================================

# ---- Database --------------------------------------------------------------
# Connect as the least-privilege `app` role from drizzle/grants.sql, never as
# the owner. Use the POOLED connection string in production.
DATABASE_URL="postgresql://app:password@host/db?sslmode=require"

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Vercel sets VERCEL_ENV automatically. Elsewhere, set APP_ENV=production on the
# deployed instance so live-key enforcement applies there and not to builds.
# APP_ENV="production"

# ---- Clerk (authentication) -----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# From Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# Comma-separated. A matching user is made org owner on first sign-in. Audited.
BOOTSTRAP_ADMIN_EMAILS="coach@example.edu"

# ---- Stripe (the ORG's account — we never hold funds) ------------------------
# A RESTRICTED key (rk_...) with exactly: Checkout Sessions: Write,
# Payment Intents: Read. Created by the org in THEIR dashboard and handed over.
# The app refuses an unrestricted sk_ key in production.
STRIPE_SECRET_KEY="rk_test_..."
# A live site may run Stripe TEST mode (no real charges, donate form shows a
# banner) only with this explicit opt-in. Remove it when the org's live key lands.
# ALLOW_TEST_PAYMENTS="true"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Signing secret for the org's webhook endpoint pointing at /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."
# The org's actual Stripe rate, used for the donor "cover processing" add-on.
# Standard is 2.9 + 30. Once Stripe approves the nonprofit rate, set 2.2.
# Defaulting to the higher rate means the org is never under-collected.
NEXT_PUBLIC_STRIPE_FEE_PERCENT="2.9"
NEXT_PUBLIC_STRIPE_FEE_FIXED_CENTS="30"

# ---- PII encryption ---------------------------------------------------------
# Generate with: npm run keys:generate
# Rotation: add a new id to PII_ENCRYPTION_KEYS, point ACTIVE at it, re-encrypt
# in the background, then remove the old id. Never delete a key still in use.
PII_ENCRYPTION_KEYS='{"k1":"<base64 32 bytes>"}'
PII_ENCRYPTION_ACTIVE_KEY_ID="k1"
PII_INDEX_KEY="<base64 32 bytes, different from above>"

# ---- Rate limiting (Upstash Redis) -----------------------------------------
# Required in production; the app refuses to start without it. Optional in dev.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="Booster Club <fundraising@yourdomain.org>"
# Resend → Webhooks → events email.bounced, email.complained → /api/webhooks/resend
RESEND_WEBHOOK_SECRET="whsec_..."

# ---- Photo uploads (Vercel Blob) --------------------------------------------
# Vercel → Storage → Blob → connect to project; the token is injected on Vercel.
# Locally, copy it here. Uploads fail closed without it; there is no disk fallback.
BLOB_READ_WRITE_TOKEN=""

# ---- Bot protection (Cloudflare Turnstile) — optional, activates when set -----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
