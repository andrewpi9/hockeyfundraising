# ---- Database (Neon, Supabase, or local Postgres) ----
# Use the POOLED connection string in production.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Stripe ----
# Test keys start with sk_test_ / pk_test_. Swap to live keys only after
# the booster club's 501(c)(3) is verified on the Stripe account.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- Email (Resend) ----
RESEND_API_KEY="re_..."
EMAIL_FROM="UNC Hockey <fundraising@yourdomain.org>"

# ---- Auth ----
# Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-32-random-bytes"

# ---- Org details shown on receipts (required for 501(c)(3) substantiation) ----
NEXT_PUBLIC_ORG_LEGAL_NAME="UNC Hockey Booster Club, Inc."
NEXT_PUBLIC_ORG_EIN="00-0000000"
NEXT_PUBLIC_ORG_ADDRESS="123 Main St, Chapel Hill, NC 27514"
